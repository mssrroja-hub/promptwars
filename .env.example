# MentiNous AI - Environment Configuration Example
# Copy this file to .env and configure your local settings if needed.

# Application Server
PORT=5000
HOST=127.0.0.1
DEBUG=False

# Security Keys (Generate a random 32-character key for production)
SECRET_KEY=mentinous_prototype_secret_key_change_in_production_32chars

# Database
DATABASE_PATH=mentinous.db

# Optional External AI API Keys (leave empty to use built-in neural-heuristic planner)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
